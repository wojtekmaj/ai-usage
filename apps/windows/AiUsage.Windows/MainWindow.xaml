<Window
    x:Class="AiUsage.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:AiUsage.Windows.UI">

    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="True"
        CompactModeThresholdWidth="640"
        ExpandedModeThresholdWidth="850"
        PaneDisplayMode="Auto"
        SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.Resources>
            <x:Double x:Key="ToggleSwitchPreContentMargin">6</x:Double>
            <x:Double x:Key="ToggleSwitchPostContentMargin">6</x:Double>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Style x:Key="SettingsSectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />
            <Style x:Key="SettingsOptionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
            <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="AccountsItem" Tag="accounts">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xE77B;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="DisplayItem" Tag="display">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xE790;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NotificationsItem" Tag="notifications">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xEA8F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="LogsItem" Tag="logs">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xF0E3;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutItem" Tag="about">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="20" Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="32,20,32,8">
                <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="AccountsSection">
                    <StackPanel x:Name="AccountCards" Margin="32,12,32,32" Spacing="16" />
                </ScrollViewer>

                <ScrollViewer x:Name="DisplaySection" Visibility="Collapsed">
                    <StackPanel Margin="32,12,32,32" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="GeneralHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <Border Style="{StaticResource SettingsGroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
                                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" HorizontalAlignment="Right" SelectionChanged="LanguageCombo_SelectionChanged" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}" />
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RefreshIntervalLabel" VerticalAlignment="Center" />
                                        <ComboBox x:Name="RefreshIntervalCombo" Grid.Column="1" HorizontalAlignment="Right" SelectionChanged="RefreshIntervalCombo_SelectionChanged">
                                            <ComboBoxItem Tag="1" Content="1 min" />
                                            <ComboBoxItem Tag="5" Content="5 min" />
                                            <ComboBoxItem Tag="10" Content="10 min" />
                                            <ComboBoxItem Tag="15" Content="15 min" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}" />
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PanelBackgroundLabel" VerticalAlignment="Center" />
                                        <ComboBox x:Name="PanelBackgroundCombo" Grid.Column="1" HorizontalAlignment="Right" SelectionChanged="PanelBackgroundCombo_SelectionChanged" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}" />
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UsageBarColorLabel" VerticalAlignment="Center" />
                                        <ComboBox x:Name="UsageBarColorCombo" Grid.Column="1" HorizontalAlignment="Right" SelectionChanged="UsageBarColorCombo_SelectionChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TrayHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <StackPanel x:Name="TrayProviderSettings" Spacing="8" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PanelHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <StackPanel x:Name="PanelProviderSettings" Spacing="8" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="NotificationsSection" Visibility="Collapsed">
                    <StackPanel Margin="32,12,32,32" Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="UsageNotificationsHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <Border Style="{StaticResource SettingsGroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="AheadTitle" Style="{StaticResource SettingsOptionTitleStyle}" />
                                            <TextBlock x:Name="AheadDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AheadToggle" Grid.Column="1" Style="{StaticResource SettingsRowToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="NotificationToggle_Toggled" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}" />
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="BehindTitle" Style="{StaticResource SettingsOptionTitleStyle}" />
                                            <TextBlock x:Name="BehindDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="BehindToggle" Grid.Column="1" Style="{StaticResource SettingsRowToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="NotificationToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ResetNotificationsHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <Border Style="{StaticResource SettingsGroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="CodexResetTitle" Style="{StaticResource SettingsOptionTitleStyle}" />
                                            <TextBlock x:Name="CodexResetDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CodexResetToggle" Grid.Column="1" Style="{StaticResource SettingsRowToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="NotificationToggle_Toggled" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}" />
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="ClaudeResetTitle" Style="{StaticResource SettingsOptionTitleStyle}" />
                                            <TextBlock x:Name="ClaudeResetDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ClaudeResetToggle" Grid.Column="1" Style="{StaticResource SettingsRowToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="NotificationToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ScheduledResetNotificationsHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <Border Style="{StaticResource SettingsGroupCardStyle}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="CodexScheduledResetTitle" Style="{StaticResource SettingsOptionTitleStyle}" />
                                            <TextBlock x:Name="CodexScheduledResetDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CodexScheduledResetToggle" Grid.Column="1" Style="{StaticResource SettingsRowToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="NotificationToggle_Toggled" />
                                    </Grid>
                                    <Border Style="{StaticResource SettingsRowDividerStyle}" />
                                    <Grid Style="{StaticResource SettingsRowStyle}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock x:Name="ClaudeScheduledResetTitle" Style="{StaticResource SettingsOptionTitleStyle}" />
                                            <TextBlock x:Name="ClaudeScheduledResetDescription" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ClaudeScheduledResetToggle" Grid.Column="1" Style="{StaticResource SettingsRowToggleStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="NotificationToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="LogsSection" Margin="32,12,32,32" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListView x:Name="LogsList" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="ui:LogDisplayEntry">
                                <Border Style="{StaticResource SettingsCardStyle}">
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyLogsButton" Click="CopyLogsButton_Click" />
                        <Button x:Name="ClearLogsButton" Click="ClearLogsButton_Click" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="AboutSection" Visibility="Collapsed">
                    <StackPanel Margin="32,12,32,32" Spacing="24" MaxWidth="720" HorizontalAlignment="Left">
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="AppNameText" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckForUpdatesButton" Click="CheckForUpdatesButton_Click" />
                                <Button x:Name="ViewReleaseButton" Click="ViewReleaseButton_Click" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                            <ToggleSwitch x:Name="AutomaticUpdateChecksToggle" Toggled="AutomaticUpdateChecksToggle_Toggled" />
                            <TextBlock x:Name="AutomaticUpdateChecksDescription" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="ProjectHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <HyperlinkButton x:Name="RepositoryButton" NavigateUri="https://github.com/wojtekmaj/ai-usage" Padding="0" />
                            <HyperlinkButton x:Name="SponsorButton" NavigateUri="https://github.com/sponsors/wojtekmaj" Padding="0" />
                            <HyperlinkButton x:Name="ReportIssueButton" NavigateUri="https://github.com/wojtekmaj/ai-usage/issues/new" Padding="0" />
                        </StackPanel>
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="LegalHeading" Style="{StaticResource SettingsSectionHeadingStyle}" />
                            <TextBlock x:Name="LegalText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
