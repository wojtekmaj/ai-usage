<Window
    x:Class="AiUsage.Windows.UsageFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Padding="16" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock x:Name="PanelTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="AuthenticationCallout" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ProviderCards" Spacing="18" />
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SettingsButton" Click="SettingsButton_Click" />
            <TextBlock x:Name="LastUpdateText" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <Button x:Name="RefreshButton" Grid.Column="2" MinWidth="0" HorizontalAlignment="Right" Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon x:Name="RefreshIcon" Symbol="Refresh" />
                    <ProgressRing x:Name="RefreshProgress" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="RefreshButtonText" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
